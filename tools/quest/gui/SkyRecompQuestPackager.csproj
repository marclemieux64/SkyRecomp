<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Skyrecomp-VR APK Builder</AssemblyName>
    <RootNamespace>SkyRecompQuestPackager</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationIcon>..\..\..\docs\icon\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadPath)' != ''">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="SkyRecomp.Payload.zip" />
  </ItemGroup>
</Project>
